{
  "name": "gltf-interactivity",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "build": "node packages/runtime-lua/scripts/build-lua-sources.mjs && tsc -b",
    "check:registry": "node packages/kernel/scripts/check-registry.mjs",
    "conf:interp": "node packages/conformance/dist/run-interp.js",
    "conf:compiled": "node packages/conformance/dist/run-compiled.js",
    "conf:lua": "node packages/conformance/dist/run-compiled-lua.js",
    "conf:roundtrip": "node packages/conformance/dist/run-roundtrip.js",
    "fuzz": "node packages/conformance/dist/fuzz.js",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm --filter @gltfi/viewer dev",
    "smoke": "node scripts/render-verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  }
}
